[Unit]
Description=Devops Grafana Restarter (once a day at midnight)
Documentation=man:systemd.service(5)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/grafana
ExecStart=/bin/bash /opt/grafana/scripts/restarter.sh
TimeoutStartSec=600
PrivateTmp=yes
ProtectSystem=full
ReadWritePaths=/usr/local/grafana/
NoNewPrivileges=yes
